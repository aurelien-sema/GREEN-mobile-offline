# Copier ce fichier en assets/.env (ignoré par git) puis renseigner les valeurs.
# Le fichier assets/.env doit exister au moment du build, même vide.
#
# ATTENTION : tout ce qui est dans assets/.env est embarqué dans l'APK et peut
# être extrait par quelqu'un de déterminé. Utilisez des clés restreintes
# (Google Cloud : restriction à l'application Android com.green.green ;
# OpenWeather : clé dédiée à l'application).

# GreenBot (Google Gemini) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Facultatif : modèle essayé en premier ; les autres restent en secours.
# Par défaut : gemini-3.5-flash-lite, puis gemini-3.5-flash, puis gemini-3.8-flash
# (liste vérifiée le 2026-11-09 avec GET /v1beta/models).
GEMINI_MODEL=
GEMINI_AUDIO_MODEL=

# Météo — https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Envoi automatique des analyses vers GREEN Web (o2switch).
GREEN_API_BASE_URL=https://api-green.gitingeniering.com
# Compte GREEN Web par défaut, utilisé par TOUS les comptes de l'application.
# E-mail (ou téléphone) + mot de passe. Sans ces valeurs, les analyses restent
# en file sur le téléphone. Recommandé : un compte dédié à l'application, avec
# un mot de passe utilisé nulle part ailleurs (il est embarqué dans l'APK).
GREEN_WEB_EMAIL=
GREEN_WEB_PHONE=
GREEN_WEB_PASSWORD=
